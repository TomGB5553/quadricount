# Copy to .env.local for local development, and set the same values in Vercel.
# Find these in the Supabase dashboard: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Receipt scanning (optional). Set EITHER (or both) — without one, the
# "Scan a receipt" button just doesn't appear. Groq is tried first when set
# (its free tier is less congested than Gemini's).
#   Groq:   free key from https://console.groq.com/keys
#   Gemini: free key from https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional model overrides
GROQ_MODEL=
GEMINI_MODEL=
