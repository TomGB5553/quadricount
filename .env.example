# Copy to .env.local for local development, and set the same values in Vercel.
# Find these in the Supabase dashboard: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Receipt scanning (optional). Free key from https://aistudio.google.com/apikey
# Without it, the "Scan a receipt" button just doesn't appear.
GEMINI_API_KEY=
# Optional override; defaults to gemini-2.0-flash
GEMINI_MODEL=
